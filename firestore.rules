rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidFeedback() {
      let d = request.resource.data;
      return d.keys().hasOnly(['category', 'message', 'appVersion', 'deviceModel', 'systemVersion', 'locale', 'timestamp'])
        && d.category in ['bug', 'feature', 'other']
        && d.message is string && d.message.size() > 0 && d.message.size() <= 80000
        && d.appVersion is string && d.appVersion.size() <= 32
        && d.deviceModel is string && d.deviceModel.size() <= 64
        && d.systemVersion is string && d.systemVersion.size() <= 32
        && d.locale is string && d.locale.size() <= 64
        && d.timestamp == request.time;
    }
    match /feedbacks/{documentId} {
      allow create: if isValidFeedback();
      allow read, update, delete: if false;
    }
  }
}
